# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only. Required for private email/student-ID sign-in alias resolution.
# Never prefix this key with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Canonical origin used for confirmation and password-recovery email links.
# Required in production. During `next dev`, a same-origin localhost or ngrok
# request safely uses its browser-facing origin, so both presentation URLs work.
APP_URL=http://localhost:3000

# Presentation seeding is intentionally opt-in and project-pinned.
ALLOW_PRESENTATION_SEED=false
PRESENTATION_SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
